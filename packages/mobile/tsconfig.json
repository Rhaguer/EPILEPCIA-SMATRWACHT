{
  "extends":"@tsconfig/react-native/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "@core/*":       ["../../core/src/*"],
      "@adapters/*":   ["adapters/*"],
      "@components/*": ["components/*"],
      "@hooks/*":      ["hooks/*"],
      "@screens/*":    ["screens/*"],
      "@storage/*":    ["storage/*"],
      "@location/*":   ["location/*"],
      "@navigation/*": ["navigation/*"]
    }
  },
  "include": ["src/**/*", "index.js"],
  "exclude": ["node_modules"]
}
