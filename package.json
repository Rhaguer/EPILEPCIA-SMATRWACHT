{
  "name": "seizure-watch",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de detección de crisis epilépticas en menores (<18) para smartwatches",
  "workspaces": [
    "packages/core",
    "packages/mobile"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:core": "npm run build -w packages/core",
    "build:mobile": "npm run build -w packages/mobile",
    "test": "npm run test --workspaces",
    "lint": "eslint packages/**/src/**/*.{ts,tsx}"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0"
  }
}
